<?xml version="1.0" encoding="UTF-8"?>
<!-- Rosettalog rule confirmation cases: shared parser for the synthetic lines. See README.md. -->
<device-extension xmlns="event_parsing/device_extension">
  <pattern id="Evt" xmlns=""><![CDATA[evt=(\w+)]]></pattern>
  <pattern id="User" xmlns=""><![CDATA[user=(\S+)]]></pattern>
  <pattern id="Src" xmlns=""><![CDATA[src=(\d+\.\d+\.\d+\.\d+)]]></pattern>
  <pattern id="Dport" xmlns=""><![CDATA[dport=(\d+)]]></pattern>
  <match-group order="1" description="rltest" xmlns="">
    <matcher field="EventName" order="1" pattern-id="Evt" capture-group="1"/>
    <matcher field="UserName" order="1" pattern-id="User" capture-group="1"/>
    <matcher field="SourceIp" order="1" pattern-id="Src" capture-group="1"/>
    <matcher field="DestinationPort" order="1" pattern-id="Dport" capture-group="1"/>
  </match-group>
</device-extension>
