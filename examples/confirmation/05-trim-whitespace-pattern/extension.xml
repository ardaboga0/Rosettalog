<?xml version="1.0" encoding="UTF-8"?>
<!-- Rosettalog confirmation case: trim-whitespace on a pattern containing spaces. Synthetic; see ../README.md. -->
<device-extension xmlns="event_parsing/device_extension">
  <pattern id="Evt" xmlns=""><![CDATA[evt=(\w+)]]></pattern>
  <pattern id="User" trim-whitespace="true" xmlns=""><![CDATA[user = (\w+)]]></pattern>
  <match-group order="1" description="only group" xmlns="">
    <matcher field="EventName" order="1" pattern-id="Evt" capture-group="1"/>
    <matcher field="UserName" order="1" pattern-id="User" capture-group="1"/>
  </match-group>
</device-extension>
