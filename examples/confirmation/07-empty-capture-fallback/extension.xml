<?xml version="1.0" encoding="UTF-8"?>
<!-- Rosettalog confirmation case: empty capture and matcher order fallback. Synthetic; see ../README.md. -->
<device-extension xmlns="event_parsing/device_extension">
  <pattern id="Evt" xmlns=""><![CDATA[evt=(\w+)]]></pattern>
  <pattern id="U1" xmlns=""><![CDATA[u1=(\w*)]]></pattern>
  <pattern id="U2" xmlns=""><![CDATA[u2=(\w+)]]></pattern>
  <match-group order="1" description="only group" xmlns="">
    <matcher field="EventName" order="1" pattern-id="Evt" capture-group="1"/>
    <matcher field="UserName" order="1" pattern-id="U1" capture-group="1"/>
    <matcher field="UserName" order="2" pattern-id="U2" capture-group="1"/>
  </match-group>
</device-extension>
