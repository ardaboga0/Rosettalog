<?xml version="1.0" encoding="UTF-8"?>
<!-- Rosettalog confirmation case: two matchers for one field with the same order. Synthetic; see ../README.md. -->
<device-extension xmlns="event_parsing/device_extension">
  <pattern id="Evt" xmlns=""><![CDATA[evt=(\w+)]]></pattern>
  <pattern id="A" xmlns=""><![CDATA[a=(\w+)]]></pattern>
  <pattern id="B" xmlns=""><![CDATA[b=(\w+)]]></pattern>
  <match-group order="1" description="only group" xmlns="">
    <matcher field="EventName" order="1" pattern-id="Evt" capture-group="1"/>
    <matcher field="UserName" order="1" pattern-id="B" capture-group="1"/>
    <matcher field="UserName" order="1" pattern-id="A" capture-group="1"/>
  </match-group>
</device-extension>
