[
  {
    "id": "bb_acme_admin_users",
    "name": "BB: Acme admin accounts",
    "kind": "detection",
    "source_format": "qradar-rules",
    "provenance": {
      "file": "examples/rules-bb/bb_rules.ir.json"
    },
    "detection": {
      "rule_id": "200001",
      "name": "BB: Acme admin accounts",
      "building_block": true,
      "condition": {
        "kind": "field",
        "field": "UserName",
        "op": "equals",
        "values": [
          "admin",
          "root"
        ],
        "case_sensitive": false,
        "path": "test[1]"
      }
    }
  },
  {
    "id": "bb_acme_test_net",
    "name": "BB: Acme documentation network sources",
    "kind": "detection",
    "source_format": "qradar-rules",
    "provenance": {
      "file": "examples/rules-bb/bb_rules.ir.json"
    },
    "detection": {
      "rule_id": "200002",
      "name": "BB: Acme documentation network sources",
      "building_block": true,
      "condition": {
        "kind": "field",
        "field": "SourceIp",
        "op": "equals",
        "values": [
          "192.0.2.60",
          "192.0.2.61"
        ],
        "case_sensitive": false,
        "path": "test[1]"
      }
    }
  },
  {
    "id": "bb_cycle_a",
    "name": "BB: cycle A",
    "kind": "detection",
    "source_format": "qradar-rules",
    "provenance": {
      "file": "examples/rules-bb/bb_rules.ir.json"
    },
    "detection": {
      "rule_id": "200003",
      "name": "BB: cycle A",
      "building_block": true,
      "condition": {
        "kind": "and",
        "items": [
          {
            "kind": "field",
            "field": "EventName",
            "op": "equals",
            "values": [
              "login_ok"
            ],
            "case_sensitive": false,
            "path": "test[1]"
          },
          {
            "kind": "rule_ref",
            "rules": [
              "200004"
            ],
            "mode": "any",
            "path": "test[2]"
          }
        ]
      }
    }
  },
