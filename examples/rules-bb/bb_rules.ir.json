  {
    "id": "acme_admin_bruteforce",
    "name": "Acme: at least 3 admin-account events from one source in 5 minutes",
    "kind": "detection",
    "source_format": "qradar-rules",
    "provenance": {
      "file": "examples/rules-bb/bb_rules.ir.json"
    },
    "detection": {
      "rule_id": "200103",
      "name": "Acme: at least 3 admin-account events from one source in 5 minutes",
      "severity": 7,
      "condition": {
        "kind": "rule_ref",
        "rules": [
          "200001"
        ],
        "mode": "any",
        "path": "test[1]"
      },
      "stateful": {
        "kind": "counter",
        "count": 3,
        "window_s": 300,
        "group_by": [
          "SourceIp"
        ],
        "path": "test[2]"
      }
    }
  },
  {
    "id": "acme_test_net_then_admin",
    "name": "Acme: documentation-network event, then admin account, same source, 2 minutes",
    "kind": "detection",
    "source_format": "qradar-rules",
    "provenance": {
      "file": "examples/rules-bb/bb_rules.ir.json"
    },
    "detection": {
      "rule_id": "200104",
      "name": "Acme: documentation-network event, then admin account, same source, 2 minutes",
      "severity": 5,
      "stateful": {
        "kind": "sequence",
        "ordered": true,
        "window_s": 120,
        "group_by": [
          "SourceIp"
        ],
        "path": "test[1]",
        "steps": [
          {
            "kind": "rule_ref",
            "rules": [
              "200002"
            ],
            "mode": "any",
            "path": "test[1]/step[1]"
          },
          {
            "kind": "rule_ref",
            "rules": [
              "200001"
            ],
            "mode": "any",
            "path": "test[1]/step[2]"
          }
        ]
      }
    }
  },
